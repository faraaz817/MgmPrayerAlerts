<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mgm_bg">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MgmText.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mosque_name" />

                    <TextView
                        android:id="@+id/dateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/mgm_text"
                        android:textSize="26sp"
                        tools:text="Wednesday 7 October" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/mgm_muted"
                        android:textSize="13sp"
                        tools:text="Updated 3:46 PM · 3 alerts set for today" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/refreshButton"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="-12dp"
                    android:contentDescription="@string/refresh"
                    app:icon="@drawable/ic_refresh"
                    app:iconTint="@color/mgm_gold" />
            </LinearLayout>

            <!-- Permission / fetch problems -->
            <LinearLayout
                android:id="@+id/bannerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Next prayer -->
            <LinearLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="28dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/heroLabel"
                        style="@style/MgmText.Overline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_on_accent_secondary"
                        tools:text="@string/next_prayer" />

                    <LinearLayout
                        android:id="@+id/heroAlertPill"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:id="@+id/heroAlertIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_bell"
                            app:tint="@color/mgm_text" />

                        <TextView
                            android:id="@+id/heroAlertText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/mgm_text"
                            android:textSize="12sp"
                            tools:text="@string/alert_on" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/heroName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/mgm_text"
                    android:textSize="22sp"
                    tools:text="Asr" />

                <TextView
                    android:id="@+id/heroTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-light"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:textColor="@color/mgm_gold"
                    android:textSize="56sp"
                    tools:text="4:56 PM" />

                <TextView
                    android:id="@+id/heroSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_on_accent_secondary"
                    android:textSize="14sp"
                    tools:text="in 1 hr 9 min · Jamaat 5:26 PM" />
            </LinearLayout>

            <!-- Today's times -->
            <TextView
                android:id="@+id/timesLabel"
                style="@style/MgmText.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/today_times" />

            <LinearLayout
                android:id="@+id/timesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/MgmText.ColumnHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:minWidth="92dp"
                        android:text="@string/column_azaan" />

                    <TextView
                        style="@style/MgmText.ColumnHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:minWidth="92dp"
                        android:text="@string/column_jamaat" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/timesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Friday only -->
            <TextView
                android:id="@+id/jumuahLabel"
                style="@style/MgmText.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/jumuah_title"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/jumuahContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone" />

            <!-- Alert settings -->
            <TextView
                style="@style/MgmText.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/alerts_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/alerts_help"
                android:textColor="@color/mgm_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/settingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:alpha="0.8"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/footer_source"
                android:textColor="@color/mgm_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Overlaid so showing/hiding it never shifts the content. -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/refreshProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/mgm_gold"
        app:trackColor="@android:color/transparent"
        app:trackThickness="3dp" />
</FrameLayout>
